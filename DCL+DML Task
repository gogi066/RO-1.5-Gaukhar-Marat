-- Business reason: Applied standard annual inflation multiplier to all courses managed by Data Science faculty.
select c.title, c.price, i.full_name from courses c join instructors i on c.instructor_id = i.instructor_id where i.expertise = 'Data Science';
update courses c
set price = round(c.price * 1.15, 2)
from instructors i
where c.instructor_id = i.instructor_id 
and i.expertise = 'Data Science';

